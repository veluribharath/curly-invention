# Copy to .env and run: flutter run --dart-define-from-file=.env
# Leave TMDB_API_KEY empty to use the built-in mock catalog.
TMDB_API_KEY=
USE_FIREBASE=false
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=com.veluribharath.reel
